<!DOCTYPE html><html lang="uz"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Akosh Market</title>
<style>
:root{--p:#5b3df5;--p2:#8b5cf6;--a:#ff6a3d;--bg:#f5f6fb;--t:#161a2b;--m:#6b7089;--g:#12b76a}
*{box-sizing:border-box;margin:0}body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--t);padding-bottom:72px}
button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}
.w{max-width:1200px;margin:auto;padding:0 16px}
header{background:#fff;position:sticky;top:0;z-index:20;box-shadow:0 2px 14px #0001}
.top{display:flex;align-items:center;gap:12px;padding:12px 0;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:20px;cursor:pointer;color:var(--p)}
.logo i{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,var(--p),var(--a));color:#fff;display:grid;place-items:center;font-style:normal}
.sb{flex:1;min-width:200px;position:relative}.sb input{width:100%;padding:12px 16px;border-radius:12px;border:2px solid #e4e6f0;outline:0}.sb input:focus{border-color:var(--p)}
#sr{position:absolute;top:100%;left:0;right:0;background:#fff;border-radius:12px;box-shadow:0 10px 30px #0003;margin-top:6px;overflow:hidden}
.sri{display:flex;gap:10px;align-items:center;padding:8px 12px;cursor:pointer}.sri:hover{background:var(--bg)}.sri .ph,.sri img{width:44px;height:44px;border-radius:8px;font-size:24px;aspect-ratio:1}
.hb2{display:flex;gap:6px}.tb{background:#fff;border:1px solid #e4e6f0;border-radius:12px;padding:10px 12px;cursor:pointer;font-weight:600;position:relative}.tb:hover{border-color:var(--p);color:var(--p)}
.tb b{position:absolute;top:-6px;right:-6px;background:var(--a);color:#fff;border-radius:10px;font-size:11px;padding:1px 6px}
.cats{display:flex;gap:8px;overflow:auto;padding:0 0 12px;scrollbar-width:none}.chip{white-space:nowrap;background:var(--bg);border-radius:20px;padding:8px 14px;cursor:pointer;font-size:14px;transition:.2s}.chip:hover,.chip.on{background:var(--p);color:#fff}
.ban{margin:20px 0;border-radius:24px;padding:48px 36px;color:#fff;background:linear-gradient(120deg,#4527d8,#8b5cf6 60%,#ff6a3d);position:relative;overflow:hidden}
.ban h1{font-size:clamp(30px,5vw,52px)}.ban p{margin:10px 0 22px;font-size:18px;opacity:.95}.ban:after{content:"🛍️";position:absolute;right:30px;bottom:-10px;font-size:150px;opacity:.25}
.btn{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;border:0;border-radius:12px;padding:12px 20px;font-weight:700;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px #5b3df555}
.btn.o{background:#fff;color:var(--p);border:2px solid var(--p)}.btn.a{background:var(--a)}.btn.r{background:#e5484d}.btn.s{padding:7px 12px;font-size:13px}
h2{margin:26px 0 14px;font-size:22px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}
.card{background:#fff;border-radius:18px;padding:12px;position:relative;cursor:pointer;transition:.25s;display:flex;flex-direction:column;gap:6px}.card:hover{transform:translateY(-6px);box-shadow:0 14px 30px #5b3df526}
.ph{border-radius:14px;display:grid;place-items:center;font-size:64px;aspect-ratio:1;background:linear-gradient(135deg,#ece8ff,#ffe9e1)}img{max-width:100%;object-fit:contain;background:#0d0d18;border-radius:14px;aspect-ratio:1;width:100%}
.card h3{font-size:15px;font-weight:600;min-height:38px}.m{color:var(--m);font-size:13px}
.bd{position:absolute;top:18px;left:18px;background:var(--a);color:#fff;border-radius:8px;padding:3px 8px;font-size:12px;font-weight:700;z-index:2}
.hh{position:absolute;top:16px;right:16px;border:0;background:#fff;border-radius:50%;width:34px;height:34px;cursor:pointer;font-size:17px;box-shadow:0 2px 8px #0002;z-index:2;color:#bbb}.hh.on{color:#e5484d}
.pr{font-size:18px;font-weight:800}.pr s{font-size:13px;color:var(--m);font-weight:400}
.box{background:#fff;border-radius:18px;padding:20px;margin:16px 0}
.pg{display:grid;grid-template-columns:1fr 1fr;gap:28px}.th{display:flex;gap:8px;margin-top:8px}.th>*{width:64px!important;font-size:24px!important}
.row{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid #eee}.row .ph,.row img{width:70px;font-size:32px}
.q{display:inline-flex;align-items:center;border:2px solid #e4e6f0;border-radius:10px}.q button{border:0;background:0;padding:6px 12px;font-size:18px;cursor:pointer}
label{display:block;font-size:13px;color:var(--m);margin:10px 0 4px}input,select,textarea{width:100%;padding:11px;border:2px solid #e4e6f0;border-radius:10px;outline:0}input:focus,select:focus,textarea:focus{border-color:var(--p)}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}
.tl{display:flex;margin:16px 0 6px}.st{flex:1;text-align:center;font-size:12px;color:var(--m);position:relative}.st:before{content:"";position:absolute;top:11px;left:-50%;right:50%;height:4px;background:#e4e6f0}.st:first-child:before{display:none}
.st i{display:block;margin:0 auto 6px;width:26px;height:26px;border-radius:50%;background:#e4e6f0;position:relative;font-style:normal;line-height:26px;color:#fff}.st.d i,.st.d:before{background:var(--g)}.st.d{color:var(--t);font-weight:600}
.msg{background:#eefbf4;border-radius:10px;padding:10px 14px;font-weight:600;color:#0a7c4a}.msg.x{background:#fdecec;color:#c62b30}
.tag{display:inline-block;padding:3px 10px;border-radius:12px;background:var(--bg);font-size:12px;font-weight:600}
.ov{position:fixed;inset:0;background:#0007;display:grid;place-items:center;z-index:50;padding:16px}.mb{background:#fff;border-radius:20px;padding:24px;max-width:520px;width:100%;max-height:90vh;overflow:auto}
.gar{display:flex;gap:12px;margin:12px 0}.gar div{flex:1;background:var(--bg);border-radius:14px;padding:14px;font-size:14px}
#toast{position:fixed;bottom:84px;left:50%;transform:translateX(-50%);background:#161a2b;color:#fff;padding:10px 18px;border-radius:12px;z-index:60;opacity:0;transition:.3s;pointer-events:none}#toast.on{opacity:1}
footer{background:#161a2b;color:#c9cce0;margin-top:40px;padding:36px 0}footer .w{display:flex;gap:40px;flex-wrap:wrap}footer a{display:block;margin:6px 0;cursor:pointer}footer b{color:#fff}
.soc a{display:inline-block;background:#ffffff1a;border-radius:10px;padding:8px 14px;margin:4px 6px 0 0}.soc a:hover{background:var(--p)}
nav.bn{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;box-shadow:0 -2px 14px #0002;z-index:30}nav.bn a{flex:1;text-align:center;padding:8px 0;font-size:11px;cursor:pointer}nav.bn a span{display:block;font-size:20px}
table{width:100%;border-collapse:collapse;font-size:14px}td,th{padding:8px;border-bottom:1px solid #eee;text-align:left}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stats div{background:#fff;border-radius:14px;padding:16px}.stats b{font-size:24px;display:block}
@media(max-width:700px){nav.bn{display:flex}.pg,.fg{grid-template-columns:1fr}.ban{padding:30px 20px}.hd{display:none}.grid{grid-template-columns:repeat(2,1fr);gap:10px}}
</style></head><body>
<header><div class="w"><div class="top"><div class="logo" onclick="go('')"><i>A</i>AKOSH MARKET</div>
<div class="sb"><input id="q" placeholder="Mahsulot qidirish..." oninput="sg(this.value)" onkeydown="if(event.key=='Enter'){go('s/'+encodeURIComponent(this.value));$('#sr').innerHTML=''}"><div id="sr"></div></div>
<div class="hb2"><button class="tb" onclick="dlv()">🚚 <span class="hd">Yetkazib berish</span></button><button class="tb hd" onclick="go('orders')">📦 Buyurtmalarim</button><button class="tb hd" onclick="go('wish')">❤️<b id="wc"></b></button><button class="tb" onclick="go('cart')">🛒 <span class="hd">Savatcha</span><b id="cc"></b></button><button class="tb" id="lg" onclick="login()">Kirish</button></div></div>
<div class="cats" id="cats"></div></div></header>
<main class="w" id="app"></main>
<footer><div class="w"><div><b style="font-size:20px">AKOSH MARKET</b><p style="margin:8px 0">Siz izlagan hamma narsa bir joyda!</p><div class="soc"><b>Bizni kuzating</b><br><a href="https://t.me/AKOSHMARKET" target="_blank" rel="noopener">✈️ Telegram</a><a href="https://instagram.com/akosh.market" target="_blank" rel="noopener">📸 Instagram</a><a href="https://youtube.com" target="_blank" rel="noopener">▶️ YouTube</a></div></div>
<div><b>Kompaniya</b><a onclick="info('Biz haqimizda','Akosh Market — O‘zbekiston bo‘ylab ishonchli onlayn do‘kon.')">Biz haqimizda</a><a onclick="info('Aloqa','Telegram: @AKOSHMARKET<br>Instagram: @akosh.market')">Aloqa</a><a onclick="dlv()">Yetkazib berish</a><a onclick="info('To‘lov','Naqd pul yoki karta orqali (qabul qilganda).')">To‘lov</a><a onclick="info('Foydalanish shartlari','Saytdan foydalanish orqali shartlarga rozilik bildirasiz.')">Foydalanish shartlari</a><a onclick="go('admin')">Admin</a></div></div></footer>
<nav class="bn"><a onclick="go('')"><span>🏠</span>Bosh</a><a onclick="scrollTo(0,0);$('#cats').scrollIntoView()"><span>📂</span>Kategoriya</a><a onclick="go('wish')"><span>❤️</span>Istaklar</a><a onclick="go('cart')"><span>🛒</span>Savatcha</a><a onclick="go('orders')"><span>👤</span>Profil</a></nav>
<div id="md"></div><div id="toast"></div>
<script>
// Supabase sozlamalari (bular ochiq bo‘lishi mumkin: faqat URL va "anon" kalit. BotFather tokenini bu yerga YOZMANG!)
const SB_URL='',SB_KEY='';
const ST=['Yangi','Qabul qilindi','Tayyorlanmoqda','Yetkazilmoqda','Yetkazildi','Bekor qilindi'];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
async function api(fn,body,hd){const r=await fetch(SB_URL+'/functions/v1/'+fn,{method:'POST',headers:{'Content-Type':'application/json',apikey:SB_KEY,Authorization:'Bearer '+SB_KEY,...hd},body:JSON.stringify(body)});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'Xato');return j}
const adm=(a,x)=>api('admin',{action:a,...x},{'x-admin-password':sessionStorage.ap||''});
const sync=(a,x)=>adm(a,x).catch(e=>toast('Serverga saqlanmadi: '+e.message));
async function loadAO(){const b=$('#ao');try{const r=await adm('list');b.innerHTML='<h3>Buyurtmalar (server)</h3><div style="overflow:auto"><table>'+(r.orders.map(o=>`<tr><td>${esc(o.order_number)}<br><span class="m">${new Date(o.created_at).toLocaleString('uz')}</span></td><td>${esc(o.customer_name)}<br><span class="m">${esc(o.phone)}</span></td><td>${esc(o.city)}<br><span class="m">${esc(o.address)}</span></td><td>${o.order_items.map(i=>esc(i.product_name)+' × '+i.quantity).join('<br>')}</td><td>${M(o.total_price)}</td><td><select onchange="setSt('${o.id}',this.value)">${ST.map(s=>`<option ${s==o.status?'selected':''}>${s}</option>`).join('')}</select></td></tr>`).join('')||'<tr><td>Buyurtma yo‘q</td></tr>')+'</table></div>'}catch(e){sessionStorage.removeItem('ap');b.textContent='Xato: '+e.message+' (sahifani yangilab, parolni qayta kiriting)'}}
async function setSt(id,s){try{const r=await adm('status',{id,status:s});toast(r.telegram?'✅ Status saqlandi, Telegramga yuborildi':'Status saqlandi, lekin Telegram yuborilmadi')}catch(e){toast('Xato: '+e.message)}}
async function tgTest(){try{const r=await adm('test');toast(r.ok?'✅ Telegram test xabari yuborildi':'❌ Telegram yuborilmadi (server loglarini tekshiring)')}catch(e){toast('Xato: '+e.message)}}
const $=s=>document.querySelector(s),L=(k,d)=>{try{return JSON.parse(localStorage.getItem('am_'+k))??d}catch(e){return d}},S=(k,v)=>localStorage.setItem('am_'+k,JSON.stringify(v));
const M=n=>String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+' so‘m';
const CATS=[['📱','Telefonlar'],['💻','Kompyuterlar'],['🎧','Elektronika'],['👕','Kiyim-kechak'],['👟','Oyoq kiyim'],['🏠','Uy-ro‘zg‘or'],['⚽','Sport'],['🎮','Gaming'],['⌚','Aksessuarlar'],['💄','Go‘zallik'],['🧸','Bolalar uchun'],['📦','Boshqa']];
const REG={'Toshkent shahri':'Yunusobod,Chilonzor,Mirzo Ulug‘bek,Yakkasaroy,Sergeli,Shayxontohur','Toshkent viloyati':'Chirchiq,Angren,Olmaliq,Bekobod,Nurafshon,Yangiyo‘l','Andijon':'Andijon,Asaka,Xonobod,Shahrixon,Qo‘rg‘ontepa','Buxoro':'Buxoro,G‘ijduvon,Kogon,Vobkent','Farg‘ona':'Farg‘ona,Qo‘qon,Marg‘ilon,Quvasoy,Rishton,Oltiariq','Jizzax':'Jizzax,G‘allaorol,Zomin','Xorazm':'Urganch,Xiva,Pitnak','Namangan':'Namangan,Chust,Pop,Uychi','Navoiy':'Navoiy,Zarafshon,Uchquduq','Qashqadaryo':'Qarshi,Shahrisabz,Kitob,G‘uzor','Qoraqalpog‘iston':'Nukus,Xo‘jayli,To‘rtko‘l','Samarqand':'Samarqand,Kattaqo‘rg‘on,Urgut','Sirdaryo':'Guliston,Sirdaryo,Shirin,Yangiyer','Surxondaryo':'Termiz,Denov,Sherobod'};
const IM={1:'data:image/jpeg;base64,',2:'data:image/jpeg;base64,',3:'data:image/jpeg;base64,',4:'data:image/jpeg;base64,',5:'data:image/jpeg;base64,'};
const D=[[1,'Kompyuter sichqonchasi (mishka)','Kompyuterlar',30000,'🖱️','Qulay, aniq sensorli sichqoncha.'],[2,'Klaviatura','Kompyuterlar',45000,'⌨️','Yumshoq tugmali, chidamli klaviatura.'],[3,'Mikrofon','Elektronika',50000,'🎤','Toza ovoz, stream va onlayn darslar uchun.'],[4,'Veb-kamera (Web camera)','Kompyuterlar',40000,'📷','Video qo‘ng‘iroqlar uchun aniq tasvir.'],[5,'Naushnik','Elektronika',60000,'🎧','Boy bas, qulay quloqchinlar.']].map(a=>({id:a[0],n:a[1],c:a[2],p:a[3],o:Math.round(a[3]*1.3/1000)*1000,e:a[4],d:a[5],r:(4.5+a[0]%5/10).toFixed(1),s:20+a[0]*13,k:50,img:IM[a[0]]}));
let P=L('p2',D),C=L('c',[]),W=L('w',[]),O=L('o',[]),U=L('u',null),promo=null;
const sv=()=>{S('p2',P);S('c',C);S('w',W);S('o',O);S('u',U)};
const go=h=>{location.hash='#/'+h},pf=id=>P.find(p=>p.id==id);
const disc=p=>p.o>p.p?Math.round(100-p.p/p.o*100):0;
const img=p=>p.img?`<img src="${p.img}" alt="">`:`<div class="ph">${p.e||'📦'}</div>`;
const toast=t=>{const e=$('#toast');e.textContent=t;e.className='on';setTimeout(()=>e.className='',1800)};
const modal=h=>$('#md').innerHTML=`<div class="ov" onclick="if(event.target==this)cl()"><div class="mb">${h}</div></div>`,cl=()=>$('#md').innerHTML='';
const info=(t,b)=>modal(`<h2 style="margin-top:0">${t}</h2><p>${b}</p><br><button class="btn" onclick="cl()">Yopish</button>`);
function dlv(){modal(`<h2 style="margin-top:0">🚚 Yetkazib berish</h2><div class="msg">2 kunda yetkazamiz!</div><div class="gar"><div>✅ <b>Sifat kafolati</b><br>Barcha tovarlar tekshirilgan, nuqson chiqsa almashtirib beramiz.</div><div>🎁 <b>Promokod AKOSH10</b><br>Birinchi buyurtmaga 10 000 so‘m chegirma.</div></div><p class="m"><b>Yetkazish hududlari:</b> ${Object.keys(REG).join(', ')} — Qo‘qon, Farg‘ona va barcha shaharlar.</p><p class="m" style="margin:8px 0">100 000 so‘mdan ortiq buyurtmada yetkazish bepul, aks holda 15 000 so‘m.</p><button class="btn" onclick="cl()">Tushunarli</button>`)}
function login(){modal(`<h2 style="margin-top:0">Kirish</h2><label>Ism</label><input id="ln" value="${U?U.n:''}"><label>Telefon</label><input id="lp" placeholder="+998" value="${U?U.p:''}"><br><br><button class="btn" onclick="doLogin()">Kirish</button> ${U?'<button class="btn o" onclick="U=null;sv();cl();hdr()">Chiqish</button>':''}`)}
function doLogin(){const n=$('#ln').value.trim(),p=$('#lp').value.trim();if(!n||!p)return toast('Ism va telefonni kiriting');U={n,p};sv();cl();hdr();toast('Xush kelibsiz, '+n)}
function hdr(){$('#cc').textContent=C.reduce((a,b)=>a+b.q,0)||'';$('#wc').textContent=W.length||'';$('#lg').textContent=U?'👤 '+U.n.split(' ')[0]:'Kirish';$('#cc').style.display=$('#cc').textContent?'':'none';$('#wc').style.display=W.length?'':'none';
 const cur=decodeURIComponent((location.hash.split('/')[1]=='c'?location.hash.split('/')[2]:'')||'');$('#cats').innerHTML=`<div class="chip ${cur?'':'on'}" onclick="go('')">Barchasi</div>`+CATS.map(c=>`<div class="chip ${cur==c[1]?'on':''}" onclick="go('c/${encodeURIComponent(c[1])}')">${c[0]} ${c[1]}</div>`).join('')}
function sg(v){v=v.trim().toLowerCase();const r=$('#sr');if(!v)return r.innerHTML='';const m=P.filter(p=>(p.n+p.c).toLowerCase().includes(v)).slice(0,6);r.innerHTML=m.length?m.map(p=>`<div class="sri" onclick="go('p/${p.id}');$('#sr').innerHTML=''">${img(p)}<div><b>${p.n}</b><div class="m">⭐ ${p.r} · ${M(p.p)}${disc(p)?` · -${disc(p)}%`:''}</div></div></div>`).join(''):'<div class="sri m">Hech narsa topilmadi</div>'}
const tw=id=>{W=W.includes(id)?W.filter(x=>x!=id):[...W,id];sv();route()};
function add(id,q=1){const i=C.find(x=>x.id==id);i?i.q+=q:C.push({id,q});sv();hdr();toast('🛒 Savatchaga qo‘shildi')}
const card=p=>`<div class="card" onclick="go('p/${p.id}')">${disc(p)?`<span class="bd">-${disc(p)}%</span>`:''}<button class="hh ${W.includes(p.id)?'on':''}" onclick="event.stopPropagation();tw(${p.id})">♥</button>${img(p)}<h3>${p.n}</h3><div class="m">⭐ ${p.r} · ${p.s} ta sotilgan</div><div class="pr">${M(p.p)} ${disc(p)?`<s>${M(p.o)}</s>`:''}</div><button class="btn s" onclick="event.stopPropagation();add(${p.id})">🛒 Savatchaga qo‘shish</button></div>`;
const grid=l=>l.length?`<div class="grid">${l.map(card).join('')}</div>`:'<div class="box m">Mahsulot topilmadi</div>';
const sec=(t,l)=>l.length?`<h2>${t}</h2>${grid(l.slice(0,10))}`:'';
function home(){return`<div class="ban"><h1>Akosh Market</h1><p>Siz izlagan hamma narsa bir joyda!</p><button class="btn a" onclick="$('#pop').scrollIntoView({behavior:'smooth'})">Hozir xarid qiling</button> <button class="btn o" onclick="dlv()">🚚 2 kunda yetkazamiz</button></div><div class="gar"><div>🚚 <b>2 kunda yetkazamiz</b><br>Butun O‘zbekiston bo‘ylab</div><div>✅ <b>Sifat kafolati</b></div><div>🎁 <b>AKOSH10</b><br>Birinchi buyurtmaga −10 000</div></div><span id="pop"></span>${sec('🔥 Mashhur mahsulotlar',[...P].sort((a,b)=>b.s-a.s))}${sec('⚡ Chegirmalar',[...P].filter(disc).sort((a,b)=>disc(b)-disc(a)))}${sec('🆕 Yangi mahsulotlar',[...P].reverse())}${sec('⭐ Yuqori reytingli',[...P].sort((a,b)=>b.r-a.r))}`}
function prod(id){const p=pf(id);if(!p)return'<div class="box">Topilmadi</div>';return`<div class="box"><div class="pg"><div>${img(p)}<div class="th">${img(p)}${img(p)}</div></div><div><h1>${p.n}</h1><p class="m">⭐ ${p.r} · ${p.s} kishi sotib oldi · Omborda: ${p.k} dona</p><div class="pr" style="font-size:30px;margin:12px 0">${M(p.p)} ${disc(p)?`<s>${M(p.o)}</s> <span class="bd" style="position:static">-${disc(p)}%</span>`:''}</div><p>${p.d}</p><p class="m" style="margin:8px 0"><b>Kategoriya:</b> ${p.c}</p><div class="msg">🚚 2 kunda yetkazamiz · ✅ Sifat kafolati</div><br><span class="q"><button onclick="qn(-1)">−</button><b id="qn" style="padding:0 8px">1</b><button onclick="qn(1)">+</button></span><br><br><button class="btn" onclick="add(${p.id},+$('#qn').textContent)">🛒 Savatchaga qo‘shish</button> <button class="btn a" onclick="add(${p.id},+$('#qn').textContent);go('checkout')">⚡ Hozir xarid qilish</button> <button class="btn o" onclick="tw(${p.id})">${W.includes(p.id)?'💔 Istakdan olish':'❤️ Istakka'}</button></div></div></div>${sec('Shunga o‘xshash mahsulotlar',P.filter(x=>x.id!=p.id&&x.c==p.c).concat(P.filter(x=>x.id!=p.id&&x.c!=p.c)).slice(0,5))}`}
const qn=d=>{const e=$('#qn');e.textContent=Math.max(1,+e.textContent+d)};
const sub=()=>C.reduce((a,i)=>a+(pf(i.id)?.p||0)*i.q,0),dfee=s=>s==0||s>=100000?0:15000;
function cart(){C=C.filter(i=>pf(i.id));const s=sub();if(!C.length)return`<div class="box">🛒 Savatcha bo‘sh <br><br><button class="btn" onclick="go('')">Xarid qilish</button></div>`;return`<h2>🛒 Savatcha</h2><div class="box">${C.map(i=>{const p=pf(i.id);return`<div class="row">${img(p)}<div style="flex:1"><b>${p.n}</b><div class="m">${M(p.p)}</div></div><span class="q"><button onclick="cq(${p.id},-1)">−</button><b>${i.q}</b><button onclick="cq(${p.id},1)">+</button></span><b>${M(p.p*i.q)}</b><button class="btn r s" onclick="C=C.filter(x=>x.id!=${p.id});sv();route()">🗑</button></div>`}).join('')}<p style="margin-top:14px">Mahsulotlar: <b>${M(s)}</b></p><p>Yetkazib berish: <b>${dfee(s)?M(dfee(s)):'Bepul'}</b></p><p class="pr">Jami: ${M(s+dfee(s))}</p><br><button class="btn" onclick="go('checkout')">Buyurtma berish</button></div>`}
const cq=(id,d)=>{const i=C.find(x=>x.id==id);i.q+=d;if(i.q<1)C=C.filter(x=>x.id!=id);sv();route()};
const dsc=()=>promo&&!L('used',false)?10000:0;
function checkout(){if(!C.length)return go('cart');const s=sub(),f=dfee(s),d=dsc();return`<h2>Buyurtma berish</h2><div class="pg"><div class="box"><div class="fg"><div><label>Ism</label><input id="cn" value="${U?U.n:''}"></div><div><label>Telefon</label><input id="cp" placeholder="+998" value="${U?U.p:''}"></div><div><label>Viloyat</label><select id="cv" onchange="cit()">${Object.keys(REG).map(r=>`<option>${r}</option>`).join('')}</select></div><div><label>Tuman/shahar</label><select id="ct"></select></div></div><label>Manzil</label><input id="ca"><div class="fg"><div><label>Yetkazib berish usuli</label><select id="cd"><option>Uyga yetkazish (2 kun)</option></select></div><div><label>To‘lov usuli</label><select id="cy"><option>Naqd (qabul qilganda)</option><option>Karta orqali (qabul qilganda)</option></select></div></div><label>Izoh</label><textarea id="cm" rows="2"></textarea><label>Promokod</label><div style="display:flex;gap:8px"><input id="pc" placeholder="AKOSH10" value="${promo||''}"><button class="btn s" onclick="pr()">Qo‘llash</button></div></div>
<div class="box"><h3>Buyurtma tarkibi</h3>${C.map(i=>{const p=pf(i.id);return`<p class="row" style="padding:6px 0"><span style="flex:1">${p.n} × ${i.q}</span><b>${M(p.p*i.q)}</b></p>`}).join('')}<p>Mahsulotlar: ${M(s)}</p><p>Yetkazib berish: ${f?M(f):'Bepul'}</p>${d?`<p style="color:var(--g)">Promokod: −${M(d)}</p>`:''}<p class="pr">Jami: ${M(s+f-d)}</p><div class="msg" style="margin:10px 0">🚚 2 kunda yetkazamiz</div><button class="btn" onclick="place()">Buyurtmani tasdiqlash</button></div></div>`}
function cit(){$('#ct').innerHTML=REG[$('#cv').value].split(',').map(c=>`<option>${c}</option>`).join('')}
function pr(){const v=$('#pc').value.trim().toUpperCase();if(v!='AKOSH10')return toast('Promokod noto‘g‘ri');if(L('used',false))return toast('Promokod faqat birinchi buyurtma uchun');promo=v;toast('✅ −10 000 so‘m chegirma');route()}
async function place(){const g=i=>$('#'+i).value.trim();if(!g('cn')||!g('cp')||!g('ca'))return toast('Ism, telefon va manzilni kiriting');const s=sub(),f=dfee(s),d=dsc();const o={id:'AM'+String(Date.now()).slice(-6),t:Date.now(),items:C.map(i=>({id:i.id,n:pf(i.id).n,q:i.q,p:pf(i.id).p})),sub:s,f,d,tot:s+f-d,name:g('cn'),ph:g('cp'),reg:g('cv'),city:g('ct'),addr:g('ca'),pay:g('cy'),note:g('cm'),st:null};if(SB_URL){try{const r=await api('create-order',{name:o.name,phone:o.ph,region:o.reg,city:o.city,address:o.addr,note:o.note,payment:o.pay,promo:promo||'',items:C.map(i=>({id:i.id,q:i.q}))});o.id=r.order_number;o.tot=r.total;o.f=r.delivery;o.d=r.discount}catch(e){return toast('Buyurtma yuborilmadi: '+e.message)}}O.unshift(o);if(o.d)S('used',true);promo=null;C=[];U=U||{n:o.name,p:o.ph};sv();toast('✅ Buyurtma qabul qilindi');go('orders')}
const stg=o=>{if(o.st=='x')return-1;if(typeof o.st=='number')return o.st;const h=(Date.now()-o.t)/36e5;return h<1?0:h<24?1:h<48?2:3};
const SN=['Qabul qilindi','Yig‘ilyapti','Yetkazilyapti','Yetkazildi'],SM=['🟡 Buyurtmangiz qabul qilindi','📦 Yig‘ilyapti — 1 kun ichida yig‘iladi','🚚 Yetkazilyapti — 1 kundan keyin yetkazib beriladi','🟢 2 kunda yetkazildi. Xaridingiz uchun rahmat!'];
function orders(){if(!O.length)return`<div class="box">📦 Hali buyurtma yo‘q <br><br><button class="btn" onclick="go('')">Xarid qilish</button></div>`;return`<h2>📦 Buyurtmalarim</h2>`+O.map(o=>{const s=stg(o);return`<div class="box"><div style="display:flex;justify-content:space-between;flex-wrap:wrap"><b>Buyurtma № ${o.id}</b><span class="m">${new Date(o.t).toLocaleString('uz')}</span></div><p class="m">${o.items.map(i=>i.n+' × '+i.q).join(', ')}</p><p><b>${M(o.tot)}</b> · ${o.reg}, ${o.city}</p>${s<0?`<div class="msg x">❌ Bekor qilindi${o.cr?': '+o.cr:''}</div>`:`<div class="tl">${SN.map((n,i)=>`<div class="st ${i<=s?'d':''}"><i>${i<=s?'✓':''}</i>${n}</div>`).join('')}</div><div class="msg">${SM[s]}</div>${s<3?`<br><button class="btn r s" onclick="cx('${o.id}')">Buyurtmani bekor qilish</button>`:''}`}</div>`}).join('')}
function cx(id){modal(`<h2 style="margin-top:0">Bekor qilish sababi</h2>${['Mahsulot kerak emas','Noto‘g‘ri mahsulot buyurtma qildim','Narxi yoqmadi','Yetkazib berish vaqti mos kelmaydi','Boshqa sabab'].map((r,i)=>`<label style="color:var(--t);font-size:15px"><input type="radio" name="rs" value="${r}" style="width:auto" ${i?'':'checked'}> ${r}</label>`).join('')}<textarea id="rt" rows="2" placeholder="Boshqa sabab bo‘lsa, izoh yozing"></textarea><br><br><button class="btn r" onclick="cx2('${id}')">Tasdiqlash</button> <button class="btn o" onclick="cl()">Orqaga</button>`)}
function cx2(id){const r=document.querySelector('[name=rs]:checked').value,t=$('#rt').value.trim();if(r.startsWith('Boshqa')&&!t)return toast('Izoh yozing');const o=O.find(x=>x.id==id);o.st='x';o.cr=r.startsWith('Boshqa')?t:r;sv();cl();route()}
const wish=()=>`<h2>❤️ Istaklarim</h2>${grid(P.filter(p=>W.includes(p.id)))}`;
function admin(){if(SB_URL){if(!sessionStorage.ap){const x=prompt('Admin parol:');if(!x)return'<div class="box">Ruxsat yo‘q</div>';sessionStorage.ap=x}}else if(sessionStorage.am!='1'){if(prompt('Admin parol:')!='akosh123'){return'<div class="box">Ruxsat yo‘q</div>'}sessionStorage.am='1'}
const rev=O.filter(o=>stg(o)>=0).reduce((a,o)=>a+o.tot,0);return`<h2>Admin panel</h2><div class="stats"><div><b>${O.length}</b>Jami buyurtmalar</div><div><b>${P.length}</b>Mahsulotlar</div><div><b>${new Set(O.map(o=>o.ph)).size}</b>Foydalanuvchilar</div><div><b>${M(rev)}</b>Sotuvlar</div><div><b>${O.filter(o=>stg(o)<3&&stg(o)>=0).length}</b>Yangi</div><div><b>${O.filter(o=>o.st=='x').length}</b>Bekor qilingan</div></div>
<div class="box"><h3 id="ft">Mahsulot qo‘shish</h3><input type="hidden" id="ai"><div class="fg"><div><label>Nomi</label><input id="an"></div><div><label>Kategoriya</label><select id="ac">${CATS.map(c=>`<option>${c[1]}</option>`).join('')}</select></div><div><label>Narxi (so‘m)</label><input id="ap" type="number"></div><div><label>Eski narx / chegirma uchun</label><input id="ao" type="number"></div><div><label>Ombordagi soni</label><input id="ak" type="number" value="50"></div><div><label>Emoji (rasm yo‘q bo‘lsa)</label><input id="ae" value="📦"></div></div><label>Tavsif</label><textarea id="ad" rows="2"></textarea><label>Rasm yuklash</label><input id="af" type="file" accept="image/*"><br><br><button class="btn" onclick="saveP()">Saqlash</button></div>
<div class="box" style="overflow:auto"><h3>Mahsulotlar</h3><table>${P.map(p=>`<tr><td>${p.n}</td><td>${M(p.p)}</td><td>${p.c}</td><td><button class="btn s" onclick="editP(${p.id})">✏️</button> <button class="btn r s" onclick="if(confirm('O‘chirilsinmi?')){P=P.filter(x=>x.id!=${p.id});sv();if(SB_URL)sync('deleteProduct',{id:${p.id}});route()}">🗑</button></td></tr>`).join('')}</table></div>
${SB_URL?'<div class="box" id="ao">Yuklanmoqda...</div><div class="box"><button class="btn s" onclick="tgTest()">🤖 Telegram test xabari</button></div>':OB()}`}
const OB=()=>`<div class="box" style="overflow:auto"><h3>Buyurtmalar</h3><table>${O.map(o=>`<tr><td>${o.id}</td><td>${o.name}<br><span class="m">${o.ph}</span></td><td>${o.reg}, ${o.city}<br><span class="m">${o.addr}</span></td><td>${M(o.tot)}</td><td><select onchange="O.find(x=>x.id=='${o.id}').st=this.value=='x'?'x':+this.value;sv();route()"><option value="">Avto (vaqt bo‘yicha)</option>${SN.map((n,i)=>`<option value="${i}" ${o.st===i?'selected':''}>${n}</option>`).join('')}<option value="x" ${o.st=='x'?'selected':''}>Bekor qilindi</option></select></td></tr>`).join('')||'<tr><td>Buyurtma yo‘q</td></tr>'}</table></div>`;
function editP(id){const p=pf(id);$('#ft').textContent='Tahrirlash';$('#ai').value=id;$('#an').value=p.n;$('#ac').value=p.c;$('#ap').value=p.p;$('#ao').value=p.o;$('#ak').value=p.k;$('#ae').value=p.e;$('#ad').value=p.d;scrollTo(0,0)}
function saveP(){const f=$('#af').files[0],fin=im=>{const id=+$('#ai').value,old=id&&pf(id),n={id:id||Date.now(),n:$('#an').value.trim(),c:$('#ac').value,p:+$('#ap').value,o:+$('#ao').value||+$('#ap').value,k:+$('#ak').value,e:$('#ae').value,d:$('#ad').value,r:old?old.r:'4.8',s:old?old.s:0,img:im??(old?old.img:'')};if(!n.n||!n.p)return toast('Nom va narxni kiriting');old?P[P.indexOf(old)]=n:P.unshift(n);sv();if(SB_URL)sync('saveProduct',{product:{id:n.id,name:n.n,category:n.c,price:n.p,old_price:n.o,stock:n.k}});route();toast('✅ Saqlandi')};
 if(!f)return fin();const r=new FileReader();r.onload=()=>{const i=new Image();i.onload=()=>{const k=Math.min(1,640/Math.max(i.width,i.height)),c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);fin(c.toDataURL('image/jpeg',.8))};i.src=r.result};r.readAsDataURL(f)}
function route(){const h=location.hash.slice(2).split('/'),a=decodeURIComponent(h[1]||'');let x;
 switch(h[0]){case'c':x=`<h2>${a}</h2>${grid(P.filter(p=>p.c==a))}`;break;case's':x=`<h2>“${a}” bo‘yicha natijalar</h2>${grid(P.filter(p=>(p.n+p.c).toLowerCase().includes(a.toLowerCase())))}`;break;case'p':x=prod(a);break;case'cart':x=cart();break;case'checkout':x=checkout();break;case'orders':x=orders();break;case'wish':x=wish();break;case'admin':x=admin();break;default:x=home()}
 $('#app').innerHTML=x;hdr();if(h[0]=='admin'&&SB_URL&&sessionStorage.ap)loadAO();if($('#cv')){cit()}scrollTo(0,0)}
addEventListener('hashchange',route);route();
</script></body></html>
